info: Formal/GCPrimitiveTopologyAxiomCheck.lean:119:0: R002.GCPrimitiveSurface.graph_degree {k l : ℤ} (hkl : l < k) (hl : 0 < l) (hprim : R002.GCPrimitive.Primitive k l)
  (x : R002.GCPrimitiveSurface.Vertex k l) :
  (R002.GCPrimitiveSurface.graph k l).degree x =
    match R002.GCPrimitiveSurface.toCanonical x with
    | Sum.inl val => 5
    | Sum.inr val => 6
