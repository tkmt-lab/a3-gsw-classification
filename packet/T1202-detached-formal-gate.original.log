info: Formal/GCPrimitiveTopologyAxiomCheck.lean:125:0: R002.GCPrimitiveSurface.triangle_iff_edges {k l : ℤ} (hkl : l < k) (hl : 0 < l)
  (x y z : R002.GCPrimitiveSurface.Vertex k l) :
  R002.GCPrimitiveSurface.Triangle x y z ↔
    (R002.GCPrimitiveSurface.graph k l).Adj x y ∧
      (R002.GCPrimitiveSurface.graph k l).Adj y z ∧ (R002.GCPrimitiveSurface.graph k l).Adj z x
