info: Formal/GCPrimitiveTopologyAxiomCheck.lean:128:0: R002.GCPrimitiveSurface.primitive_finite_decision {k l : ℤ} (hkl : l < k) (hl : 0 < l)
  (hprim : R002.GCPrimitive.Primitive k l) (t : R002.OrderedTriangle (R002.GCPrimitiveSurface.graph k l))
  (hc : ClaudeChallenge.deg (R002.GCPrimitiveSurface.graph k l) t.a = 5)
  (hb : ClaudeChallenge.deg (R002.GCPrimitiveSurface.graph k l) t.b = 6) :
  have hG := ⋯;
  have cone := fun v ↦ ClaudeChallenge.deg (R002.GCPrimitiveSurface.graph k l) v = 5;
  ∃ r ≤ Nat.card (R002.GCPrimitiveSurface.Vertex k l),
    R002.FirstRepeat (R002.forcedWalk (R002.GCPrimitiveSurface.graph k l) hG t) r ∧
      ((∃ n p, R002.LiteralPathFrom (R002.GCPrimitiveSurface.graph k l) cone t p n) ↔
        ∃ e < r, R002.LegalConeEndpoint cone (R002.forcedWalk (R002.GCPrimitiveSurface.graph k l) hG t) e)
